{
  "global": {
    "palette": {
      "white": { "value": "#ffffff", "type": "color" },
      "ink": { "value": "#0f172a", "type": "color" },
      "paper": { "value": "#f6f7fc", "type": "color" },
      "night": { "value": "#090d16", "type": "color" },
      "navy": { "value": "#111827", "type": "color" },
      "purple": { "value": "#4f46e5", "type": "color" },
      "lavender": { "value": "#e0e7ff", "type": "color" }
    },
    "font": {
      "family": { "value": "Inter", "type": "fontFamilies" },
      "fallback": { "value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "type": "other" },
      "size": {
        "xs": { "value": "12px", "type": "fontSizes" },
        "sm": { "value": "14px", "type": "fontSizes" },
        "md": { "value": "16px", "type": "fontSizes" },
        "lg": { "value": "20px", "type": "fontSizes" },
        "xl": { "value": "32px", "type": "fontSizes" },
        "display": { "value": "64px", "type": "fontSizes" },
        "workspaceDisplay": { "value": "clamp({font.size.xl}, 5vw, {font.size.display})", "type": "fontSizes" },
        "landingDisplay": { "value": "clamp({font.size.xl}, 7vw, {font.size.display})", "type": "fontSizes" }
      },
      "weight": {
        "regular": { "value": "400", "type": "fontWeights" },
        "medium": { "value": "500", "type": "fontWeights" },
        "bold": { "value": "700", "type": "fontWeights" }
      },
      "lineHeight": { "value": "150%", "type": "lineHeights" },
      "headingLineHeight": { "value": "110%", "type": "lineHeights" },
      "tracking": {
        "brand": { "value": "0.04em", "type": "letterSpacing" },
        "eyebrow": { "value": "0.12em", "type": "letterSpacing" }
      }
    },
    "space": {
      "1": { "value": "4px", "type": "spacing" },
      "2": { "value": "8px", "type": "spacing" },
      "3": { "value": "12px", "type": "spacing" },
      "4": { "value": "16px", "type": "spacing" },
      "5": { "value": "24px", "type": "spacing" },
      "6": { "value": "32px", "type": "spacing" },
      "7": { "value": "48px", "type": "spacing" },
      "8": { "value": "64px", "type": "spacing" },
      "9": { "value": "96px", "type": "spacing" }
    },
    "radius": {
      "sm": { "value": "8px", "type": "borderRadius" },
      "md": { "value": "16px", "type": "borderRadius" },
      "lg": { "value": "24px", "type": "borderRadius" },
      "pill": { "value": "999px", "type": "borderRadius" }
    },
    "shadow": {
      "none": { "value": "none", "type": "other" }
    },
    "border": {
      "width": {
        "thin": { "value": "1px", "type": "borderWidth" },
        "focus": { "value": "3px", "type": "borderWidth" }
      }
    },
    "layout": {
      "maxWidth": { "value": "1120px", "type": "sizing" },
      "formWidth": { "value": "440px", "type": "sizing" },
      "controlHeight": { "value": "44px", "type": "sizing" },
      "previewHeight": { "value": "220px", "type": "sizing" }
    }
  },
  "light": {
    "color": {
      "background": { "value": "{palette.paper}", "type": "color" },
      "surface": { "value": "{palette.white}", "type": "color" },
      "surfaceRaised": { "value": "#eef0f8", "type": "color" },
      "text": { "value": "{palette.ink}", "type": "color" },
      "muted": { "value": "#526079", "type": "color" },
      "border": { "value": "#cbd2e2", "type": "color" },
      "accent": { "value": "{palette.purple}", "type": "color" },
      "accentHover": { "value": "#4338ca", "type": "color" },
      "onAccent": { "value": "{palette.white}", "type": "color" },
      "highlight": { "value": "{palette.lavender}", "type": "color" },
      "onHighlight": { "value": "{palette.ink}", "type": "color" },
      "error": { "value": "#b42335", "type": "color" },
      "success": { "value": "#16704a", "type": "color" },
      "focus": { "value": "{palette.purple}", "type": "color" }
    }
  },
  "dark": {
    "color": {
      "background": { "value": "{palette.night}", "type": "color" },
      "surface": { "value": "{palette.navy}", "type": "color" },
      "surfaceRaised": { "value": "#1c273b", "type": "color" },
      "text": { "value": "#f1f4fa", "type": "color" },
      "muted": { "value": "#a3afc5", "type": "color" },
      "border": { "value": "#3a4761", "type": "color" },
      "accent": { "value": "#a5b4fc", "type": "color" },
      "accentHover": { "value": "#c7d2fe", "type": "color" },
      "onAccent": { "value": "{palette.ink}", "type": "color" },
      "highlight": { "value": "#273257", "type": "color" },
      "onHighlight": { "value": "{palette.lavender}", "type": "color" },
      "error": { "value": "#fda4af", "type": "color" },
      "success": { "value": "#6ee7b7", "type": "color" },
      "focus": { "value": "{color.accent}", "type": "color" }
    }
  },
  "$themes": [
    { "id": "retrest-light", "name": "Light", "selectedTokenSets": { "global": "source", "light": "enabled", "dark": "disabled" } },
    { "id": "retrest-dark", "name": "Dark", "selectedTokenSets": { "global": "source", "light": "disabled", "dark": "enabled" } }
  ],
  "$metadata": { "tokenSetOrder": ["global", "light", "dark"] }
}
