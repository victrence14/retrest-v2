# Private, server-side credentials. Copy to .env locally; never use VITE_ prefixes.
# Get your own key in Stitch Settings -> API / API Keys (see the official MCP guide).
STITCH_API_KEY=
# Existing project ID from your Stitch project link; also accepts projects/ID.
STITCH_PROJECT_ID=
STITCH_MCP_URL=https://stitch.googleapis.com/mcp
STITCH_API_BASE_URL=https://stitch.googleapis.com
