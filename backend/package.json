{
  "name": "@retrest/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "worker:email": "tsx src/workers/email-worker.ts",
    "worker:email:once": "tsx src/workers/email-worker.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:http:remote": "node tests/http-smoke.mjs",
    "test:database": "tsx --test tests/database.test.ts tests/features-database.test.ts",
    "schema:export": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "tsx": "^4.20.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "supabase": "^3.3.0",
    "typescript": "~5.9.3"
  }
}
