      "post": {
        "tags": [
          "Pools"
        ],
        "summary": "Create a pool whose member shares equal the target",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subscription_id",
                  "name",
                  "target_amount",
                  "currency",
                  "members"
                ],
                "properties": {
                  "subscription_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string"
                  },
                  "target_amount": {
                    "type": "integer"
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "NGN",
                      "USD"
                    ]
                  },
                  "fallback_enabled": {
                    "type": "boolean"
                  },
                  "members": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "email",
                        "share_amount"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "share_amount": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "invite_expires_in_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created pool and members"
          },
          "400": {
            "description": "Invalid pool payload"
          },
          "404": {
            "description": "Subscription not found"
          },
          "409": {
            "description": "Pool already exists"
          }
        }
      }
    },
