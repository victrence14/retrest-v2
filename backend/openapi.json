{
  "openapi": "3.0.3",
  "info": {
    "title": "Retrest API",
    "version": "0.1.0",
    "description": "Retrest subscription payment shield. Money is integer minor units in NGN or USD. Errors return a JSON error object. Protected routes require a Supabase Bearer access token."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health"
    },
    {
      "name": "Auth",
      "description": "Session"
    },
    {
      "name": "Dashboard",
      "description": "Owner financial snapshot"
    },
    {
      "name": "Settings",
      "description": "Owner settings"
    },
    {
      "name": "Card",
      "description": "Master virtual card"
    },
    {
      "name": "Wallet",
      "description": "Wallet balances, funding, FX quotes"
    },
    {
      "name": "Authorizations",
      "description": "Payment authorization ledger decisions"
    },
    {
      "name": "Subscriptions",
      "description": "Merchant subscription rules"
    },
    {
      "name": "Transactions",
      "description": "Authorization ledger history"
    },
    {
      "name": "Notifications",
      "description": "Owner notifications"
    },
    {
      "name": "Webhooks",
      "description": "Issuer callbacks"
    },
    {
      "name": "Pools"
    },
    {
      "name": "Invites"
    },
    {
      "name": "Devices"
    },
    {
      "name": "Receipts"
    },
    {
      "name": "Exports"
    },
    {
      "name": "Insights"
    },
    {
      "name": "Spend summaries"
    },
    {
      "name": "Support"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "A Bearer access token is required."
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "ngn_balance": {
            "type": "integer"
          },
          "usd_balance": {
            "type": "integer"
          },
          "auto_fx_enabled": {
            "type": "boolean"
          },
          "fx_converted_ngn": {
            "type": "integer"
          }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "masked_pan": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "FROZEN"
            ]
          },
          "provider_card_id": {
            "type": "string"
          },
          "provider_customer_id": {
            "type": "string"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "category_slug": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "NGN",
              "USD"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "merchant_name": {
            "type": "string"
          },
          "merchant_descriptor": {
            "type": "string"
          },
          "max_amount_minor": {
            "type": "integer"
          },
          "billing_cycle": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "YEARLY"
            ]
          },
          "next_billing_date": {
            "type": "string"
          },
          "is_business_expense": {
            "type": "boolean"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authorization_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_name": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "NGN",
              "USD"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "read_at": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "AuthorizationDecision": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "DECLINE"
            ]
          },
          "reason": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string"
          },
          "receipt_url": {
            "type": "string"
          },
          "fx_ngn_amount": {
            "type": "integer"
          },
          "pool_amount": {
            "type": "integer"
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "NGN",
              "USD"
            ]
          },
          "merchant_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service healthy"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current session user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session user"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Read owner profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Update owner display name",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "display_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Owner financial snapshot",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Read owner settings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet settings"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "patch": {
        "tags": [
          "Settings"
        ],
        "summary": "Update auto-FX setting",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "auto_fx_enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/card": {
      "get": {
        "tags": [
          "Card"
        ],
        "summary": "Read owner master card",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Card"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "tags": [
          "Card"
        ],
        "summary": "Freeze or unfreeze master card",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "FROZEN"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Card"
        ],
        "summary": "Issue owner master virtual card",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Issued card and wallet"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/wallet": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "Read owner wallet",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/wallet/fx-quote": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "FX quote (NGN per USD)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "FX quote"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/authorizations": {
      "post": {
        "tags": [
          "Authorizations"
        ],
        "summary": "Authorize a provider payment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization outcome"
          },
          "400": {
            "description": "Invalid payload"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unknown card or merchant"
          }
        }
      }
    },
    "/api/subscriptions": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "List owner merchant subscriptions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Subscriptions"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Create a merchant subscription rule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "merchant_name",
                  "merchant_descriptor",
                  "expected_amount_minor",
                  "currency",
                  "next_billing_date"
                ],
                "properties": {
                  "merchant_name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "merchant_descriptor": {
                    "type": "string",
                    "pattern": "^[A-Z0-9 _.-]{2,60}$"
                  },
                  "category_slug": {
                    "type": "string"
                  },
                  "expected_amount_minor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_amount_minor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "NGN",
                      "USD"
                    ]
                  },
                  "billing_cycle": {
                    "type": "string",
                    "enum": [
                      "MONTHLY",
                      "YEARLY"
                    ]
                  },
                  "next_billing_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "is_business_expense": {
                    "type": "boolean"
                  },
                  "plan_name": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid payload"
          },
          "409": {
            "description": "Duplicate merchant descriptor"
          }
        }
      }
    },
    "/api/subscriptions/{id}": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Read one merchant subscription",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Update a merchant rule (atomic single write)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "PAUSED"
                    ]
                  },
                  "max_amount_minor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "next_billing_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "is_business_expense": {
                    "type": "boolean"
                  },
                  "plan_name": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Delete a merchant rule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "List owner transactions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "NGN",
                "USD"
              ]
            }
          },
          {
            "name": "merchant",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List owner notifications",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notifications"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/webhooks/card-auth": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Issuer card authorization callback",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization outcome"
          },
          "400": {
            "description": "Invalid payload"
          },
          "401": {
            "description": "Invalid signature"
          },
          "413": {
            "description": "Payload too large"
          },
          "503": {
            "description": "Webhook secret not configured"
          }
        }
      }
    },
    "/api/subscription-categories": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "List reference subscription categories",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Categories"
          }
        }
      }
    },
    "/api/transactions/{id}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Read one transaction (receipt snapshot source)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    },
    "/api/receipts/{id}": {
      "get": {
        "tags": [
          "Receipts"
        ],
        "summary": "Get the settled receipt snapshot for a transaction",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt"
          },
          "404": {
            "description": "Receipt not found"
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "tags": [
          "Exports"
        ],
        "summary": "Export a month of transactions as CSV or JSON",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Export totals and rows"
          },
          "400": {
            "description": "Invalid month"
          }
        }
      }
    },
    "/api/insights": {
      "get": {
        "tags": [
          "Insights"
        ],
        "summary": "Monthly totals, top merchants and review flags",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Insights"
          },
          "400": {
            "description": "Invalid month"
          }
        }
      }
