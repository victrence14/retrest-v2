{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "paths": { "@retrest/shared": ["../shared/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "../shared/src/**/*.ts"]
}
