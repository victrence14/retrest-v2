NODE_ENV=development
PORT=3001
# Exact browser origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SQLite demo database, relative to backend/. Use :memory: for throwaway runs.
DATABASE_PATH=data/retrest.sqlite

# Demo engine. Set both secrets before exposing the API beyond a local demo.
RETREST_DEMO_ENABLED=true
RETREST_SESSION_SECRET=replace-with-a-long-random-secret
CARD_WEBHOOK_SECRET=replace-with-another-long-random-secret

# Optional Supabase auth/profile API. Leave blank to disable /api/me and /api/profile (503).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Use only for explicitly privileged server jobs; NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
