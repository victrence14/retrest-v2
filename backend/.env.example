NODE_ENV=development
PORT=3001
# Exact browser origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only actual reverse proxy addresses/subnets. Use false for direct API exposure.
TRUST_PROXY=loopback
# SQLite demo database, relative to backend/. Use :memory: for throwaway runs.
DATABASE_PATH=data/retrest.sqlite

# Demo engine. Set both secrets before exposing the API beyond a local demo.
RETREST_DEMO_ENABLED=false
RETREST_SESSION_SECRET=replace-with-a-long-random-secret
CARD_WEBHOOK_SECRET=replace-with-another-long-random-secret

# Account auth + /api/v1 features use Supabase PostgreSQL with RLS.
# Blank values keep the local SQLite demo available; account APIs answer 503.
SUPABASE_URL=https://hyysivfbfqqjmukvjpty.supabase.co
SUPABASE_ANON_KEY=
# Required only for signed settlement/email webhooks and the email worker.
# NEVER expose this key to the frontend. User requests use the verified JWT + RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Must also be allow-listed in Supabase Auth settings.
AUTH_REDIRECT_URL=http://localhost:3000/login
AUTH_RECOVERY_REDIRECT_URL=http://localhost:3000/reset-password

# RETREST's persistent asynchronous staff inbox.
SUPPORT_ENABLED=true

# Trusted provider adapters sign the settlement contracts in docs/API.md.
# Leave blank until the adapter is connected. Must have at least 32 characters.
SETTLEMENT_WEBHOOK_SECRET=

# Monthly summaries: explicit requests and opted-in automatic monthly delivery share the outbox.
EMAIL_PROVIDER=disabled
MONTHLY_EMAIL_SCHEDULING_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=
# Resend/Svix signing secret from the webhook configuration (whsec_...).
RESEND_WEBHOOK_SECRET=
