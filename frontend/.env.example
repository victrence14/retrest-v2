# Where the Express backend listens. Next.js proxies /api/* here and Server Components read from it.
API_URL=http://127.0.0.1:3001

# Direct local access validates Origin against the incoming Host, so localhost,
# 127.0.0.1 and LAN addresses work without an override.
# Set to the exact public frontend origin (no trailing slash) behind a TLS-terminating proxy.
# APP_ORIGIN=https://app.example.com
