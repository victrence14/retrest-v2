# Browser-safe project credentials (Supabase Settings > API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# /api is proxied in development/preview; production needs a reverse proxy or API origin.
VITE_API_URL=/api
# This variable configures Vite's server; it is not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:3001
# NEVER add SUPABASE_SERVICE_ROLE_KEY or a VITE_ service-role key here.
